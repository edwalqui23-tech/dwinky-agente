# Copia este archivo como ".env" y llena tus valores reales.
# NUNCA subas el archivo ".env" real a internet ni lo compartas.

# Inventas esta palabra tú mismo (ej: dwinky2026). Se usa para verificar el webhook con Meta.
VERIFY_TOKEN=

# Se obtiene al configurar WhatsApp Cloud API en Meta for Developers.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Token de acceso de tu Página de Facebook (sirve para Messenger e Instagram).
PAGE_ACCESS_TOKEN=

# Tu llave de la API de Anthropic (console.anthropic.com).
ANTHROPIC_API_KEY=

# Para que te lleguen los pedidos/visitas automáticamente por correo (resend.com, tiene plan gratis).
RESEND_API_KEY=
EMAIL_NOTIFICACIONES=hola@dwinky.com

# Opcional: tu número para recibir la notificación también por WhatsApp (con código de país, sin +, ej: 573235178058).
# Solo funciona sin restricciones si TÚ le escribiste primero al bot dentro de las últimas 24h (ver README).
WHATSAPP_DUENO=
